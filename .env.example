# Quill environment

# SQLite for local dev. Use a Postgres URL in prod.
# Use an ABSOLUTE path here: Prisma 6 + Next 16 / Turbopack resolves
# the SQLite URL relative to its own runtime cwd, which is not always
# the project root. The relative form below works for `prisma db push`
# but breaks the dev-server query path. Either:
#   DATABASE_URL="file:/absolute/path/to/prisma/dev.db"
# or copy + edit on first install:
#   DATABASE_URL="file:$PWD/prisma/dev.db"  # bash will expand at copy time
DATABASE_URL="file:./prisma/dev.db"


# Solana base RPC. Devnet for build, mainnet-beta for prod.
NEXT_PUBLIC_SOLANA_NETWORK="devnet"
NEXT_PUBLIC_BASE_RPC="https://api.devnet.solana.com"

# MagicBlock TEE (PER) endpoints. Devnet pairs with first, mainnet with second.
NEXT_PUBLIC_EPHEMERAL_RPC="https://tee.magicblock.app"
NEXT_PUBLIC_EPHEMERAL_WS="wss://tee.magicblock.app"

# Default token mint exposed in the UI. USDC-Dev on devnet shown below.
NEXT_PUBLIC_DEFAULT_MINT="4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU"

# Server secret used to AES-GCM-wrap CLI/agent burner keys. Min 32 chars.
# Generate: openssl rand -hex 32
SCHEDULER_SECRET=""
